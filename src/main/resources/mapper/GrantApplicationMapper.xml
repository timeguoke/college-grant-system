    <!-- 根据ID查询申请详情 -->
    <select id="selectDetailById" resultMap="applicationVOMap">
        SELECT
            a.id,
            a.type_id,
            t.type_name,
            a.apply_reason,
            a.family_situation,
            a.status,
            a.reviewer_id,
            ru.name AS reviewer_name,
            a.review_comment,
            a.review_time,
            a.student_id,
            s.student_no,
            s.name AS student_name,
            a.create_time,
            a.update_time
        FROM grant_application a
                 LEFT JOIN grant_type t ON a.type_id = t.id
                 LEFT JOIN sys_user ru ON a.reviewer_id = ru.id AND ru.role = 1
                 LEFT JOIN student s ON a.student_id = s.id
        WHERE a.id = #{id}
    </select>

</mapper>